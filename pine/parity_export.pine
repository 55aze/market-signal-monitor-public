//@version=5
indicator("DXDX parity export v1", overlay=false, max_bars_back=1000, precision=12)

// ==================== 抄底化出信号 部分 ====================
// 核心参数和指标计算 - Exactly matching FuTu indicator
D = ta.ema(close, 12) - ta.ema(close, 26)
A = ta.ema(D, 9)
M = (D - A) * 2
// 使用与FuTu完全相同的计算方式
// BARSLAST equivalent in Pine
N1 = ta.barssince(M[1] >= 0 and M < 0)
MM1 = ta.barssince(M[1] <= 0 and M > 0)
// 确保N1和MM1不为na
N1 := nz(N1, 0)
MM1 := nz(MM1, 0)
// 价格低点识别 - Direct port from FuTu
CC1 = ta.lowest(close, N1 + 1)
CC2 = CC1[MM1 + 1]  // REF equivalent
CC3 = CC2[MM1 + 1]  // REF equivalent
// MACD低点识别 - Direct port from FuTu
DIFL1 = ta.lowest(D, N1 + 1)
DIFL2 = DIFL1[MM1 + 1]
DIFL3 = DIFL2[MM1 + 1]
// 价格高点识别 - Direct port from FuTu
CH1 = ta.highest(close, MM1 + 1)
CH2 = CH1[N1 + 1]
CH3 = CH2[N1 + 1]
// MACD高点识别 - Direct port from FuTu
DIFH1 = ta.highest(D, MM1 + 1)
DIFH2 = DIFH1[N1 + 1]
DIFH3 = DIFH2[N1 + 1]
// 抄底信号条件 - Direct port from FuTu
AAA = (CC1 < CC2) and (DIFL1 > DIFL2) and (M[1] < 0) and (D < 0)
BBB = (CC1 < CC3) and (DIFL1 < DIFL2) and (DIFL1 > DIFL3) and (M[1] < 0) and (D < 0)
CCC = (AAA or BBB) and (D < 0)
LLL = (not CCC[1]) and CCC
XXX = ((AAA[1] and (DIFL1 <= DIFL2) and (D < A)) or
       (BBB[1] and (DIFL1 <= DIFL3) and (D < A)))
JJJ = CCC[1] and (math.abs(D[1]) >= (math.abs(D) * 1.01))
BLBL = JJJ[1] and CCC and ((math.abs(D[1]) * 1.01) <= math.abs(D))
DXDX = (not JJJ[1]) and JJJ
// COUNT function equivalent in Pine
countCondition(condition, length) =>
    math.sum(condition ? 1 : 0, length)
// 抄底警告信号 - Direct port from FuTu
DJGXX = ((close < CC2 or close < CC1) and
         ((JJJ[MM1 + 1] or JJJ[MM1]) and
         (not LLL[1]) and
         (countCondition(JJJ, 24) >= 1)))
DJXX = (not (countCondition(DJGXX[1], 2) >= 1)) and DJGXX
DXX = (XXX or DJXX) and not CCC
// 卖出信号条件 - Direct port from FuTu
ZJDBL = (CH1 > CH2) and (DIFH1 < DIFH2) and (M[1] > 0) and (D > 0)
GXDBL = (CH1 > CH3) and (DIFH1 > DIFH2) and (DIFH1 < DIFH3) and (M[1] > 0) and (D > 0)
DBBL = (ZJDBL or GXDBL) and (D > 0)
DBL = (not DBBL[1]) and (DBBL and (D > A))
DBLXS = ((ZJDBL[1] and (DIFH1 >= DIFH2) and (D > A)) or
         (GXDBL[1] and (DIFH1 >= DIFH3) and (D > A)))
DBJG = DBBL[1] and (D[1] >= (D * 1.01))
DBJGXC = (not DBJG[1]) and DBJG
DBJGBL = DBJG[1] and (DBBL and ((D[1] * 1.01) <= D))
// 卖出警告信号 - Direct port from FuTu
ZZZZZ = ((close > CH2 or close > CH1) and
         ((DBJG[N1 + 1] or DBJG[N1]) and
         (not DBL[1]) and
         (countCondition(DBJG, 23) >= 1)))
YYYYY = (not (countCondition(ZZZZZ[1], 2) >= 1)) and ZZZZZ
WWWWW = (DBLXS or YYYYY) and not DBBL

// ==================== 蓝黄隧道 部分 ====================
// 定义参数，与原指标保持一致
n1 = input.int(26, "蓝色通道周期", minval=1)
n2 = input.int(89, "黄色通道周期", minval=1)
wid = input.int(1, "线宽", minval=1, maxval=5)
// ==================== EMA 均线部分 ====================
// EMA 显示控制参数
show_ema20 = input.bool(true, "显示 EMA 20")
show_ema50 = input.bool(true, "显示 EMA 50")
show_ema100 = input.bool(true, "显示 EMA 100")
show_ema200 = input.bool(true, "显示 EMA 200")
ema_width = input.int(1, "EMA线宽", minval=1, maxval=5)
// 计算EMA值
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)
// 定义粉色系列 - 相同色调，不同饱和度和亮度
ema_pink_1 = color.rgb(255, 192, 203)    // EMA 20 - 高亮度，低饱和度
ema_pink_2 = color.rgb(255, 20, 147)     // EMA 50 - 中亮度，高饱和度
ema_pink_3 = color.rgb(199, 21, 133)     // EMA 100 - 中等亮度，中饱和度
ema_pink_4 = color.rgb(139, 69, 19)      // EMA 200 - 低亮度，低饱和度
// 计算蓝色通道 (短期通道，周期为26)
blueUpperBand = ta.ema(high, n1)
blueLowerBand = ta.ema(low, n1)
// 计算黄色通道 (长期通道，周期为89)
yellowUpperBand = ta.ema(high, n2)
yellowLowerBand = ta.ema(low, n2)
// 定义填充区域颜色
blueColor = color.new(color.blue, 70)
yellowColor = color.new(color.yellow, 70)
// 绘制蓝色通道
blueUpperLine = close > blueUpperBand ? blueUpperBand : na
blueLowerLine = close < blueLowerBand ? blueLowerBand : na
blueMidLine = close > blueLowerBand and close < blueUpperBand ? math.avg(blueUpperBand, blueLowerBand) : na
// 绘制黄色通道
yellowUpperLine = close > yellowUpperBand ? yellowUpperBand : na
yellowLowerLine = close < yellowLowerBand ? yellowLowerBand : na
yellowMidLine = close > yellowLowerBand and close < yellowUpperBand ? math.avg(yellowUpperBand, yellowLowerBand) : na

// Diagnostic outputs only: na booleans remain -1, false=0, true=1.
plot(D, title="D")
plot(A, title="A")
plot(M, title="M")
plot(N1, title="N1")
plot(MM1, title="MM1")
plot(CC1, title="CC1")
plot(CC2, title="CC2")
plot(CC3, title="CC3")
plot(DIFL1, title="DIFL1")
plot(DIFL2, title="DIFL2")
plot(DIFL3, title="DIFL3")
plot(CH1, title="CH1")
plot(CH2, title="CH2")
plot(CH3, title="CH3")
plot(DIFH1, title="DIFH1")
plot(DIFH2, title="DIFH2")
plot(DIFH3, title="DIFH3")
plot(na(AAA) ? -1 : AAA ? 1 : 0, title="AAA")
plot(na(BBB) ? -1 : BBB ? 1 : 0, title="BBB")
plot(na(CCC) ? -1 : CCC ? 1 : 0, title="CCC")
plot(na(LLL) ? -1 : LLL ? 1 : 0, title="LLL")
plot(na(XXX) ? -1 : XXX ? 1 : 0, title="XXX")
plot(na(JJJ) ? -1 : JJJ ? 1 : 0, title="JJJ")
plot(na(BLBL) ? -1 : BLBL ? 1 : 0, title="BLBL")
plot(na(DXDX) ? -1 : DXDX ? 1 : 0, title="DXDX")
plot(na(DJGXX) ? -1 : DJGXX ? 1 : 0, title="DJGXX")
plot(na(DJXX) ? -1 : DJXX ? 1 : 0, title="DJXX")
plot(na(DXX) ? -1 : DXX ? 1 : 0, title="DXX")
plot(na(ZJDBL) ? -1 : ZJDBL ? 1 : 0, title="ZJDBL")
plot(na(GXDBL) ? -1 : GXDBL ? 1 : 0, title="GXDBL")
plot(na(DBBL) ? -1 : DBBL ? 1 : 0, title="DBBL")
plot(na(DBL) ? -1 : DBL ? 1 : 0, title="DBL")
plot(na(DBLXS) ? -1 : DBLXS ? 1 : 0, title="DBLXS")
plot(na(DBJG) ? -1 : DBJG ? 1 : 0, title="DBJG")
plot(na(DBJGXC) ? -1 : DBJGXC ? 1 : 0, title="DBJGXC")
plot(na(DBJGBL) ? -1 : DBJGBL ? 1 : 0, title="DBJGBL")
plot(na(ZZZZZ) ? -1 : ZZZZZ ? 1 : 0, title="ZZZZZ")
plot(na(YYYYY) ? -1 : YYYYY ? 1 : 0, title="YYYYY")
plot(na(WWWWW) ? -1 : WWWWW ? 1 : 0, title="WWWWW")
plot(ema20, title="ema20")
plot(ema50, title="ema50")
plot(ema100, title="ema100")
plot(ema200, title="ema200")
plot(blueUpperBand, title="blueUpperBand")
plot(blueLowerBand, title="blueLowerBand")
plot(yellowUpperBand, title="yellowUpperBand")
plot(yellowLowerBand, title="yellowLowerBand")
plot(barstate.isconfirmed ? 1 : 0, title="bar_confirmed")
plot(time_close, title="time_close")
plot(ta.valuewhen(barstate.isfirst, time, 0), title="first_time")
